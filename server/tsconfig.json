{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",
    
    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "moduleResolution": "nodenext",
    
    // Stricter Typechecking
    "strict": true,
    "noUncheckedIndexedAccess": true,
    
    // Interop
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  
  // FIX: Explicitly tell TS to only look in src
  "include": [
    "src/**/*"
  ],
  
  // FIX: Explicitly ignore config files and node_modules
  "exclude": [
    "node_modules",
    "dist",
    "jest.config.ts",
    "prisma.config.ts",
    "**/*.test.ts"
  ]
}